@page "/Account/Login"
@using Microsoft.AspNetCore.Identity
@using Website_Designer_Ghana.Data

<PageTitle>Secure Client Sign In | ZAK I.T. WORLD</PageTitle>

<main class="login-shell">
    <div class="login-window">
        <aside class="login-context">
            <a href="/" class="login-brand" aria-label="ZAK I.T. WORLD home"><img src="/images/zakitworld_logo.png" alt="ZAK I.T. WORLD" /></a>
            <div class="context-copy">
                <span class="security-label"><i class="bi bi-shield-check"></i> SECURE CLIENT ACCESS</span>
                <h1>Your technology workspace, protected.</h1>
                <p>Sign in to manage your account and access authorised ZAK I.T. WORLD services.</p>
                <ul><li><i class="bi bi-check2-circle"></i> Encrypted connection</li><li><i class="bi bi-check2-circle"></i> Account lockout protection</li><li><i class="bi bi-check2-circle"></i> Two-factor authentication support</li></ul>
            </div>
            <p class="support-note">Need help? <a href="/contact">Contact support</a></p>
        </aside>

        <section class="login-form-panel" aria-labelledby="login-title">
            <div class="login-form-heading"><span>WELCOME BACK</span><h2 id="login-title">Sign in to your account</h2><p>Enter the email and password associated with your account.</p></div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message" role="alert"><i class="bi bi-exclamation-triangle"></i><span>@errorMessage</span></div>
            }
            <EditForm EditContext="editContext" method="post" OnSubmit="LoginUser" FormName="login">
                <DataAnnotationsValidator />
                <div class="form-group"><label for="Input.Email">Email address</label><div class="input-with-icon"><i class="bi bi-envelope"></i><InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" type="email" autocomplete="username" placeholder="name@company.com" /></div><ValidationMessage For="() => Input.Email" class="text-danger small" /></div>
                <div class="form-group"><div class="label-row"><label for="Input.Password">Password</label><a href="Account/ForgotPassword">Forgot password?</a></div><div class="input-with-icon"><i class="bi bi-lock"></i><InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="current-password" placeholder="Enter your password" /></div><ValidationMessage For="() => Input.Password" class="text-danger small" /></div>
                <div class="remember-row"><InputCheckbox @bind-Value="Input.RememberMe" id="rememberMe" /><label for="rememberMe">Keep me signed in on this device</label></div>
                <button type="submit" class="btn-login">Sign in securely <i class="bi bi-arrow-right"></i></button>
                <p class="privacy-copy"><i class="bi bi-lock-fill"></i> Your credentials are protected and never shared.</p>
                <div class="login-footer">New client? <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">Create an account</a></div>
            </EditForm>
        </section>
    </div>
</main>
