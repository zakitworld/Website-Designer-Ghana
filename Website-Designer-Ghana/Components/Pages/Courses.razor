@page "/courses"
@inject IJSRuntime JS

<PageTitle>Professional Technology Training | ZAK I.T. WORLD</PageTitle>

<section class="courses-hero-section d-flex align-items-center position-relative overflow-hidden"><div class="container py-5"><div class="row align-items-center gy-5">
    <div class="col-lg-7 fade-in"><span class="eyebrow">ZAK I.T. WORLD ACADEMY</span><h1 class="display-2 fw-bold mb-4 text-white">BUILD PRACTICAL<br /><span class="text-secondary">TECHNOLOGY SKILLS</span></h1><p class="lead text-secondary mb-5 course-lead">Instructor-guided programmes built around real tools, responsible practice and portfolio-ready projects—not passive theory.</p><div class="d-flex gap-3 flex-wrap"><a href="#course-catalog" class="btn btn-secondary btn-lg px-5"><i class="bi bi-mortarboard me-2"></i>Explore programmes</a><a href="/contact" class="btn btn-outline-light btn-lg px-5"><i class="bi bi-chat-dots me-2"></i>Talk to admissions</a></div></div>
    <div class="col-lg-5"><div class="learning-panel glass-card p-4 p-lg-5"><div class="d-flex align-items-center gap-3 mb-4"><span class="learning-icon"><i class="bi bi-terminal"></i></span><div><small class="text-secondary text-uppercase">Learning model</small><h2 class="h4 text-white mb-0">Learn. Build. Demonstrate.</h2></div></div><ul class="learning-list"><li><i class="bi bi-check2-circle"></i> Guided practical labs</li><li><i class="bi bi-check2-circle"></i> Mentor feedback and code review</li><li><i class="bi bi-check2-circle"></i> Ethical and security-first practice</li><li><i class="bi bi-check2-circle"></i> Completion certificate</li></ul></div></div>
</div></div></section>

<section class="py-5 bg-black section" id="course-catalog"><div class="container py-5"><div class="text-center mb-5"><span class="eyebrow">CAREER-FOCUSED PROGRAMMES</span><h2 class="display-5 fw-bold text-white">Choose Your Learning Path</h2><p class="lead text-secondary mx-auto" style="max-width:760px">Each programme connects directly to the services our team delivers and can be adapted for individuals or corporate cohorts.</p></div><div class="row g-4">
    @foreach (var course in CourseCatalog)
    {
        <div class="col-md-6 col-xl-4"><article class="course-card h-100"><div class="course-icon"><i class="bi @course.Icon"></i></div><div class="d-flex gap-2 mb-3"><span class="course-badge">@course.Level</span><span class="course-badge">@course.Format</span></div><h3 class="h4 text-white">@course.Title</h3><p class="text-secondary">@course.Description</p><ul class="course-outcomes">@foreach (var outcome in course.Outcomes) { <li><i class="bi bi-arrow-right-short"></i>@outcome</li> }</ul><a href="/contact" class="course-link">Request next intake <i class="bi bi-arrow-up-right"></i></a></article></div>
    }
</div></div></section>

<section class="py-5 training-method section"><div class="container py-5"><div class="row g-4 align-items-center"><div class="col-lg-5"><span class="eyebrow">HOW IT WORKS</span><h2 class="display-5 fw-bold text-white">Training That Transfers to Real Work</h2><p class="text-secondary lead">Clear outcomes, hands-on delivery and responsible use of professional tools.</p></div><div class="col-lg-7"><div class="row g-3"><div class="col-sm-6"><div class="method-card"><strong>01</strong><h3>Assess</h3><p>Establish your starting point and learning goals.</p></div></div><div class="col-sm-6"><div class="method-card"><strong>02</strong><h3>Practise</h3><p>Complete guided labs and realistic assignments.</p></div></div><div class="col-sm-6"><div class="method-card"><strong>03</strong><h3>Build</h3><p>Create a demonstrable capstone project.</p></div></div><div class="col-sm-6"><div class="method-card"><strong>04</strong><h3>Progress</h3><p>Leave with feedback and a development roadmap.</p></div></div></div></div></div></div></section>

<section class="cta-section py-5"><div class="container py-5"><div class="row align-items-center"><div class="col-lg-8"><h2 class="display-5 fw-bold text-white">Need Team Training?</h2><p class="lead text-secondary mb-lg-0">We design private programmes around your systems, capability gaps and business objectives.</p></div><div class="col-lg-4 text-lg-end"><a href="/contact" class="btn btn-secondary btn-lg px-5">Plan a cohort</a></div></div></div></section>

@code {
    private sealed record Course(string Title, string Icon, string Level, string Format, string Description, string[] Outcomes);
    private static readonly Course[] CourseCatalog =
    [
        new("Software Engineering Foundations", "bi-code-slash", "Beginner", "Project-based", "Build a strong foundation in programming, web architecture, Git and secure development habits.", ["Programming fundamentals", "Web and API concepts", "Git-based workflow"]),
        new("C# & .NET Application Development", "bi-braces-asterisk", "Intermediate", "Hands-on", "Create maintainable applications and APIs using C#, .NET, Entity Framework Core and testing practices.", ["C# and object-oriented design", "ASP.NET Core APIs", "Data access and testing"]),
        new("SQL & Database Administration", "bi-database-gear", "Beginner–Intermediate", "Lab-based", "Design, query, secure and maintain relational databases for reliable business systems.", ["Data modelling and SQL", "Performance and indexing", "Backup, recovery and access control"]),
        new("IT Support & Systems Operations", "bi-pc-display-horizontal", "Beginner", "Scenario-based", "Develop practical troubleshooting, endpoint, networking and service-desk skills.", ["Hardware and OS support", "Networking fundamentals", "Incident documentation"]),
        new("Cybersecurity & Ethical Testing", "bi-shield-lock", "Intermediate", "Controlled labs", "Learn defensive foundations and authorised assessment methods in safe, scoped environments.", ["Threat and risk fundamentals", "Web security and OWASP", "Reporting and remediation"]),
        new("Technology Strategy for Leaders", "bi-diagram-3", "Professional", "Workshop", "Make better technology decisions through architecture, risk, governance and roadmap fundamentals.", ["Technology assessment", "Vendor and solution evaluation", "Practical transformation roadmaps"])
    ];
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) await JS.InvokeVoidAsync("refreshScrollAnimations"); }
}
