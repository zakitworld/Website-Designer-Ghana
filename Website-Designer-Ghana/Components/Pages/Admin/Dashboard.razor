@page "/admin"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout

<PageTitle>Dashboard | ZAK I.T. WORLD Admin</PageTitle>

<div class="admin-dashboard">
    <div class="dashboard-heading"><div><span class="admin-eyebrow">OVERVIEW</span><h1>Dashboard</h1><p>Monitor content, enquiries and publishing activity.</p></div><div class="quick-actions"><a href="/admin/blog-posts/create" class="btn btn-secondary"><i class="bi bi-plus-lg"></i> New post</a><a href="/admin/contact-submissions" class="btn btn-outline-light"><i class="bi bi-inbox"></i> View enquiries</a></div></div>

    @if (isLoading)
    {
        <div class="dashboard-loading" role="status"><span class="spinner-border text-primary"></span><span>Loading workspace…</span></div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="admin-error" role="alert"><i class="bi bi-exclamation-triangle"></i><div><strong>Dashboard data could not be loaded</strong><p>@errorMessage</p></div><button class="btn btn-outline-light btn-sm" @onclick="LoadDataAsync">Try again</button></div>
    }
    else
    {
        <div class="metric-grid">
            <a href="/admin/blog-posts" class="metric-card"><span class="metric-icon blue"><i class="bi bi-file-earmark-text"></i></span><div><small>ALL POSTS</small><strong>@TotalPosts</strong><span>@DraftPosts drafts</span></div></a>
            <a href="/admin/blog-posts" class="metric-card"><span class="metric-icon green"><i class="bi bi-broadcast"></i></span><div><small>PUBLISHED</small><strong>@PublishedPosts</strong><span>@TotalViews.ToString("N0") total views</span></div></a>
            <a href="/admin/portfolios" class="metric-card"><span class="metric-icon red"><i class="bi bi-briefcase"></i></span><div><small>PORTFOLIO</small><strong>@TotalPortfolios</strong><span>projects recorded</span></div></a>
            <a href="/admin/contact-submissions" class="metric-card"><span class="metric-icon amber"><i class="bi bi-inbox"></i></span><div><small>ENQUIRIES</small><strong>@TotalSubmissions</strong><span>@UnreadSubmissions unread</span></div></a>
        </div>

        <div class="dashboard-grid">
            <section class="admin-panel posts-panel"><header><div><span>CONTENT</span><h2>Recent blog posts</h2></div><a href="/admin/blog-posts">Manage all <i class="bi bi-arrow-right"></i></a></header>
                @if (blogPosts?.Any() == true)
                {
                    <div class="table-responsive"><table class="admin-table"><thead><tr><th>Post</th><th>Status</th><th>Views</th><th>Updated</th><th></th></tr></thead><tbody>@foreach(var post in blogPosts.Take(6)){<tr><td><strong>@post.Title</strong><small>@(post.Category?.Name ?? "Uncategorised")</small></td><td><span class="status-pill @(post.IsPublished ? "published" : "draft")">@(post.IsPublished ? "Published" : "Draft")</span></td><td>@post.ViewCount.ToString("N0")</td><td>@(post.UpdatedAt ?? post.CreatedAt).ToString("dd MMM yyyy")</td><td><a href="/admin/blog-posts/edit/@post.Id" aria-label="Edit @post.Title"><i class="bi bi-pencil-square"></i></a></td></tr>}</tbody></table></div>
                }
                else { <div class="admin-empty"><i class="bi bi-file-earmark-plus"></i><h3>No posts yet</h3><p>Create the first insight for your audience.</p><a href="/admin/blog-posts/create" class="btn btn-secondary btn-sm">Create post</a></div> }
            </section>

            <section class="admin-panel enquiry-panel"><header><div><span>INBOX</span><h2>Latest enquiries</h2></div><a href="/admin/contact-submissions">View all <i class="bi bi-arrow-right"></i></a></header>
                @if(contactSubmissions?.Any()==true){<div class="enquiry-list">@foreach(var item in contactSubmissions.Take(6)){<a href="/admin/contact-submissions" class="enquiry-item @(item.IsRead ? null : "unread")"><span class="avatar">@GetInitials(item.FullName)</span><div><strong>@item.FullName</strong><small>@item.Subject</small></div><time>@item.SubmittedAt.ToString("dd MMM")</time></a>}</div>}
                else { <div class="admin-empty"><i class="bi bi-inbox"></i><h3>Inbox is clear</h3><p>New contact enquiries will appear here.</p></div> }
            </section>
        </div>
    }
</div>
