@page "/pricing"
@inject IJSRuntime JS

<PageTitle>Services & Engagement Models | ZAK I.T. WORLD</PageTitle>

<section class="pricing-hero-section d-flex align-items-center"><div class="container py-5"><div class="row align-items-center gy-5"><div class="col-lg-7"><span class="pricing-eyebrow">CLEAR SCOPE. ACCOUNTABLE DELIVERY.</span><h1 class="display-2 fw-bold text-white">FLEXIBLE TECHNOLOGY<br /><span class="text-secondary">ENGAGEMENTS</span></h1><p class="lead text-secondary pricing-lead">Every organisation has different systems, risks and priorities. We price against a confirmed scope so you pay for the outcome you need—not an arbitrary bundle.</p><div class="d-flex gap-3 flex-wrap"><a href="#engagements" class="btn btn-secondary btn-lg px-5">View options</a><a href="/contact" class="btn btn-outline-light btn-lg px-5">Request an estimate</a></div></div><div class="col-lg-5"><div class="estimate-panel"><i class="bi bi-clipboard2-check"></i><h2>How estimates work</h2><ol><li>Discovery conversation</li><li>Requirements and risk review</li><li>Written scope, timeline and price</li></ol><p>No obligation. No hidden scope.</p></div></div></div></div></section>

<section class="py-5 bg-black section" id="engagements"><div class="container py-5"><div class="text-center mb-5"><span class="pricing-eyebrow">ENGAGEMENT MODELS</span><h2 class="display-5 fw-bold text-white">Choose How We Work Together</h2><p class="lead text-secondary mx-auto" style="max-width:780px">Start with the model that best matches your requirement. We will recommend the most efficient approach after discovery.</p></div><div class="row g-4 justify-content-center">
    @foreach (var model in Models)
    {
        <div class="col-lg-4 col-md-6"><article class="engagement-card h-100 @(model.Featured ? "featured" : "")">@if(model.Featured){<span class="recommended">MOST FLEXIBLE</span>}<div class="engagement-icon"><i class="bi @model.Icon"></i></div><p class="model-label">@model.Label</p><h3>@model.Title</h3><p class="text-secondary">@model.Description</p><ul>@foreach(var item in model.Items){<li><i class="bi bi-check2"></i>@item</li>}</ul><a href="/contact" class="btn @(model.Featured ? "btn-secondary" : "btn-outline-light") w-100 mt-auto">Discuss this model</a></article></div>
    }
</div></div></section>

<section class="py-5 service-estimates section"><div class="container py-5"><div class="row g-5"><div class="col-lg-4"><span class="pricing-eyebrow">WHAT SHAPES THE PRICE</span><h2 class="display-5 fw-bold text-white">Transparent, Scope-Based Estimates</h2><p class="text-secondary">Complexity, integrations, data sensitivity, response time, testing depth and support coverage determine the final investment.</p></div><div class="col-lg-8"><div class="row g-3">
    @foreach(var service in Services){<div class="col-md-6"><div class="service-estimate"><i class="bi @service.Icon"></i><div><h3>@service.Name</h3><p>@service.Basis</p></div></div></div>}
</div></div></div></div></section>

<section class="py-5"><div class="container py-5"><div class="scope-note"><div><span class="pricing-eyebrow">OUR COMMITMENT</span><h2 class="text-white">Know What You Are Approving</h2><p class="text-secondary mb-0">Before work begins, you receive defined deliverables, assumptions, responsibilities, milestones and payment terms. Changes are agreed before they affect cost.</p></div><a href="/contact" class="btn btn-secondary btn-lg px-5">Start discovery</a></div></div></section>

@code {
    private sealed record Model(string Title,string Label,string Icon,string Description,string[] Items,bool Featured=false);
    private sealed record Service(string Name,string Icon,string Basis);
    private static readonly Model[] Models =
    [
        new("Fixed-Scope Project","DEFINED OUTCOME","bi-box-seam","Best for a well-understood deliverable with agreed acceptance criteria.",["Written requirements and milestones","Agreed delivery schedule","Change-control process"]),
        new("Dedicated Delivery","ONGOING CAPACITY","bi-kanban","Flexible monthly access to engineering, database, support or advisory capacity.",["Prioritised delivery backlog","Regular progress reporting","Scale capacity as needs change"],true),
        new("Assessment & Advisory","TIME-BOUND REVIEW","bi-clipboard-data","Focused technical, architecture or security assessment followed by a clear action plan.",["Defined assessment scope","Evidence-based findings","Prioritised recommendations"])
    ];
    private static readonly Service[] Services =
    [
        new("Software Development","bi-code-square","Features, platforms, integrations, assurance and delivery timeline."),
        new("Database Services","bi-database-check","Data volume, platform, migration risk, availability and performance needs."),
        new("IT Support","bi-headset","Users, devices, locations, coverage hours and response targets."),
        new("Technology Consultancy","bi-lightbulb","Business objectives, stakeholders, current-state complexity and outputs."),
        new("Penetration Testing","bi-shield-lock","Authorised targets, test depth, environment, retesting and reporting needs.")
    ];
    protected override async Task OnAfterRenderAsync(bool firstRender){if(firstRender) await JS.InvokeVoidAsync("refreshScrollAnimations");}
}
