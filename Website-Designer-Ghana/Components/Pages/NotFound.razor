@page "/not-found"
@layout MainLayout

<PageTitle>Page Not Found - ZAK I.T. WORLD</PageTitle>

<section class="error-section d-flex align-items-center min-vh-100 py-5 position-relative overflow-hidden">
    <!-- Animated Background Blobs -->
    <div class="position-absolute bg-primary rounded-circle blur-3 opacity-20 w-50 h-50 top-0 start-0 translate-middle animate-float-slow"></div>
    <div class="position-absolute bg-secondary rounded-circle blur-3 opacity-10 w-25 h-25 bottom-0 end-0 translate-middle animate-float-reverse"></div>

    <div class="container text-center position-relative">
        <div class="row justify-content-center">
            <div class="col-lg-8 fade-in">
                <div class="error-content glass-card p-5">
                    <h1 class="display-1 fw-bold text-white mb-0" style="font-size: 8rem; letter-spacing: -5px;">4<span class="text-secondary">0</span>4</h1>
                    <div class="h3 fw-bold text-white text-uppercase letter-spacing-2 mb-4">Page Not Found</div>
                    
                    <p class="lead text-white text-opacity-75 mb-5 mx-auto" style="max-width: 600px;">
                        The digital path you're looking for seems to have vanished into the void. 
                        Let's get you back on track to building something great.
                    </p>

                    <div class="d-flex justify-content-center gap-3">
                        <a href="/" class="btn btn-primary btn-lg px-5">Return Home</a>
                        <a href="/contact" class="btn btn-outline-light btn-lg px-5">Contact Support</a>
                    </div>
                </div>

                <div class="mt-5 text-secondary text-opacity-50 small">
                    Error Code: 0x404_VOID_EXCEPTION
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .error-section {
        background-color: var(--color-bg-primary);
    }

    .error-content h1 {
        line-height: 1;
        filter: drop-shadow(0 0 30px rgba(59, 130, 246, 0.3));
    }

    .letter-spacing-2 {
        letter-spacing: 2px;
    }

    .fade-in {
        animation: fadeInScale 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes fadeInScale {
        from {
            opacity: 0;
            transform: scale(0.9);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@media (max-width: 767.98px) {
        .error-content {
            padding: 1.5rem !important;
        }

        .error-content h1 {
            font-size: clamp(4rem, 30vw, 6rem) !important;
            letter-spacing: 0 !important;
        }

        .error-content .d-flex {
            flex-direction: column;
            align-items: center;
        }

        .error-content .btn {
            width: 100%;
            max-width: 280px;
        }
    }
</style>
