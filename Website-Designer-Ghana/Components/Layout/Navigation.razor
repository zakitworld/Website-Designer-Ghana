@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@implements IDisposable

<!-- Bootstrap Navbar -->
<nav class="navbar navbar-expand-lg fixed-top navbar-dark zak-navbar" aria-label="Primary navigation">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="#home">
            <img src="/images/zakitworld_logo.png" alt="ZAK I.T. WORLD" class="brand-logo" height="48">
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
            aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item">
                    <a class="nav-link fw-medium @GetActiveClass("/")" href="/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-medium" href="/#about">About</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-medium" href="/#services">Services</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-medium @GetActiveClass("/courses")" href="/courses">Courses</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-medium @GetActiveClass("/pricing")" href="/pricing">Pricing</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-medium" href="/#portfolio">Portfolio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link fw-medium @GetActiveClass("/blog")" href="/blog">Blog</a>
                </li>
                <li class="nav-item ms-lg-3">
                    <a class="btn @GetContactButtonClass() px-4 fw-medium text-white" href="/contact">Contact Us</a>
                </li>

                <li class="d-lg-none mobile-account-links mt-3 pt-3">
                    <AuthorizeView>
                        <Authorized>
                            <AuthorizeView Roles="Admin" Context="adminContext">
                                <Authorized>
                                    <a href="/admin" class="nav-utility-link d-block mb-2">
                                        <i class="bi bi-gear-fill me-1"></i>Admin Dashboard
                                    </a>
                                </Authorized>
                            </AuthorizeView>
                            <a href="Account/Manage" class="nav-utility-link d-block mb-2">My
                                Account</a>
                            <form action="Account/Logout" method="post">
                                <AntiforgeryToken />
                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                                </button>
                            </form>
                        </Authorized>
                        <NotAuthorized>
                            <a href="/Account/Login" data-enhance-nav="false" class="nav-utility-link d-block">Client Login</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </li>
            </ul>

            <div class="desktop-account-links d-none d-lg-flex ms-3 ps-3 align-items-center">
                <AuthorizeView>
                    <Authorized>
                        <AuthorizeView Roles="Admin" Context="adminContext">
                            <Authorized>
                                <a href="/admin" class="nav-utility-link small me-3">
                                    <i class="bi bi-gear-fill me-1"></i>Admin Dashboard
                                </a>
                            </Authorized>
                        </AuthorizeView>
                        <a href="Account/Manage" class="nav-utility-link small me-3">My Account</a>
                        <form action="Account/Logout" method="post" style="display:inline;">
                            <AntiforgeryToken />
                            <input type="hidden" name="returnUrl" value="@currentUrl" />
                            <button type="submit"
                                class="nav-utility-link btn btn-link p-0 small">Logout</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/Account/Login" data-enhance-nav="false" class="nav-utility-link small">Client Login</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</nav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }

    private string GetActiveClass(string path)
    {
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        // Remove query string and hash if present
        currentPath = currentPath.Split('?')[0].Split('#')[0];

        // Normalize paths
        if (string.IsNullOrEmpty(currentPath))
            currentPath = "/";
        else if (!currentPath.StartsWith("/"))
            currentPath = "/" + currentPath;

        // Check if paths match
        bool isActive = currentPath.Equals(path, StringComparison.OrdinalIgnoreCase);

        return isActive ? "active" : "";
    }

    private string GetContactButtonClass()
    {
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        currentPath = currentPath.Split('?')[0].Split('#')[0];

        if (string.IsNullOrEmpty(currentPath))
            currentPath = "/";
        else if (!currentPath.StartsWith("/"))
            currentPath = "/" + currentPath;

        bool isActive = currentPath.Equals("/contact", StringComparison.OrdinalIgnoreCase);

        return isActive ? "btn-danger" : "btn-primary";
    }
}
