@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="admin-wrapper">
    @if (sidebarOpen) { <button type="button" class="admin-sidebar-overlay" aria-label="Close navigation" @onclick="CloseSidebar"></button> }
    <aside class="admin-sidebar @(sidebarOpen ? "show" : null)" aria-label="Administration navigation">
        <div class="sidebar-brand"><a href="/admin"><img src="/images/zakitworld_logo.png" alt="" /><span><strong>ZAK I.T. WORLD</strong><small>Administration</small></span></a><button type="button" class="sidebar-close d-lg-none" aria-label="Close navigation" @onclick="CloseSidebar"><i class="bi bi-x-lg"></i></button></div>
        <nav class="sidebar-nav">
            <span class="nav-section">Overview</span>
            <a href="/admin" class="@GetNavClass("/admin", true)" @onclick="CloseSidebar"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
            <span class="nav-section">Content</span>
            <a href="/admin/blog-posts" class="@GetNavClass("/admin/blog-posts")" @onclick="CloseSidebar"><i class="bi bi-file-earmark-text"></i><span>Blog posts</span></a>
            <a href="/admin/blog-categories" class="@GetNavClass("/admin/blog-categories")" @onclick="CloseSidebar"><i class="bi bi-tags"></i><span>Categories</span></a>
            <a href="/admin/blog-comments" class="@GetNavClass("/admin/blog-comments")" @onclick="CloseSidebar"><i class="bi bi-chat-left-text"></i><span>Comments</span></a>
            <a href="/admin/portfolios" class="@GetNavClass("/admin/portfolios")" @onclick="CloseSidebar"><i class="bi bi-briefcase"></i><span>Portfolio</span></a>
            <a href="/admin/courses" class="@GetNavClass("/admin/courses")" @onclick="CloseSidebar"><i class="bi bi-mortarboard"></i><span>Courses</span></a>
            <span class="nav-section">Operations</span>
            <a href="/admin/contact-submissions" class="@GetNavClass("/admin/contact-submissions")" @onclick="CloseSidebar"><i class="bi bi-inbox"></i><span>Enquiries</span></a>
        </nav>
        <div class="sidebar-footer"><a href="/" target="_blank" rel="noopener noreferrer"><i class="bi bi-box-arrow-up-right"></i><span>View public website</span></a></div>
    </aside>

    <div class="admin-content">
        <header class="admin-header"><button type="button" class="sidebar-toggle d-lg-none" aria-label="Open navigation" @onclick="OpenSidebar"><i class="bi bi-list"></i></button><div class="header-context"><span>ADMIN CONSOLE</span><strong>@CurrentSection</strong></div><div class="header-actions"><AuthorizeView><Authorized><a href="/Account/Manage" class="admin-user" title="Account settings"><i class="bi bi-person-circle"></i><span>@context.User.Identity?.Name</span></a><form action="/Account/Logout" method="post"><AntiforgeryToken /><input type="hidden" name="returnUrl" value="/" /><button type="submit" class="logout-button" title="Sign out"><i class="bi bi-box-arrow-right"></i><span>Sign out</span></button></form></Authorized></AuthorizeView></div></header>
        <main class="admin-main">@Body</main>
    </div>
</div>

@code {
    private bool sidebarOpen;
    private string currentPath = string.Empty;
    private string CurrentSection => currentPath switch { var p when p.Contains("blog-post") => "Blog posts", var p when p.Contains("blog-categor") => "Categories", var p when p.Contains("blog-comment") => "Comments", var p when p.Contains("portfolio") => "Portfolio", var p when p.Contains("course") => "Courses", var p when p.Contains("contact") => "Enquiries", _ => "Dashboard" };
    protected override void OnInitialized(){UpdatePath();NavigationManager.LocationChanged+=OnLocationChanged;}
    private void UpdatePath()=>currentPath=NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();
    private void OnLocationChanged(object? sender,LocationChangedEventArgs args){UpdatePath();sidebarOpen=false;InvokeAsync(StateHasChanged);}
    private void OpenSidebar()=>sidebarOpen=true;
    private void CloseSidebar()=>sidebarOpen=false;
    public void Dispose()=>NavigationManager.LocationChanged-=OnLocationChanged;

    private string GetNavClass(string href, bool exact = false)
    {
        var target = href.TrimStart('/');
        var active = exact ? currentPath is "admin" or "admin/" : currentPath.StartsWith(target, StringComparison.OrdinalIgnoreCase);
        return $"sidebar-link {(active ? "active" : string.Empty)}";
    }
}
