<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>ZAK I.T. WORLD | Software, Data, IT & Cybersecurity</title>
    <meta name="description"
        content="ZAK I.T. WORLD provides software development, database services, IT support, technology consultancy and professional penetration testing in Ghana and beyond." />
    <meta name="keywords" content="software development Ghana, database services Ghana, IT support Ghana, IT consultancy Ghana, penetration testing Ghana, cybersecurity Accra" />
    <meta name="author" content="ZAK I.T. WORLD" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://zakitworld.com/" />
    <meta property="og:title" content="ZAK I.T. WORLD | Secure Technology for Growth" />
    <meta property="og:description" content="Software, database, IT support, consultancy and penetration testing services from Ghana." />
    <meta property="og:image" content="https://zakitworld.com/images/zakitworld_logo.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://zakitworld.com/" />
    <meta property="twitter:title" content="ZAK I.T. WORLD | Secure Technology for Growth" />
    <meta property="twitter:description" content="Software, database, IT support, consultancy and penetration testing services from Ghana." />
    <meta property="twitter:image" content="https://zakitworld.com/images/zakitworld_logo.png" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap"
        rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Devicon for Tech Stack Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">

    <link rel="stylesheet" href="/app.css" />
    <link rel="stylesheet" href="/Website-Designer-Ghana.styles.css" />
    <link rel="icon" type="image/png" href="/images/zakitworld_logo.png" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Structured Data for SEO -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Organization",
        "name": "ZAK I.T. WORLD",
        "url": "https://zakitworld.com",
        "logo": "https://zakitworld.com/images/zakitworld_logo.png",
        "description": "Software development, database, IT support, consultancy and penetration testing services.",
        "address": {
            "@@type": "PostalAddress",
            "addressLocality": "Accra",
            "addressCountry": "Ghana"
        },
        "contactPoint": {
            "@@type": "ContactPoint",
            "telephone": "+233-245-314-860",
            "contactType": "Customer Service",
            "email": "contact@@zakitworld.com"
        },
        "sameAs": [
            "https://twitter.com/zakitworld",
            "https://instagram.com/zakitworld",
            "https://linkedin.com/company/zakitworld"
        ]
    }
    </script>
    <ImportMap />
    <HeadOutlet @rendermode="@PageRenderMode" />
</head>

<body>
    <Routes @rendermode="@PageRenderMode" />
    <script src="/_framework/blazor.web.js"></script>
    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <script src="/js/site.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode
        => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
